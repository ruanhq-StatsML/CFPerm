% --- primary: EMNLP 2018 (ACL Anthology) ------------------------------------
@inproceedings{yang-etal-2018-hotpotqa,
  title         = {{HotpotQA}: A Dataset for Diverse, Explainable Multi-hop Question Answering},
  author        = {Yang, Zhilin and Qi, Peng and Zhang, Saizheng and Bengio, Yoshua and Cohen, William and Salakhutdinov, Ruslan and Manning, Christopher D.},
  editor        = {Riloff, Ellen and Chiang, David and Hockenmaier, Julia and Tsujii, Jun{'}ichi},
  booktitle     = {Proceedings of the 2018 Conference on Empirical Methods in Natural Language Processing},
  month         = oct # {--} # nov,
  year          = {2018},
  address       = {Brussels, Belgium},
  publisher     = {Association for Computational Linguistics},
  pages         = {2369--2380},
  isbn          = {978-1-948087-84-1},
  doi           = {10.18653/v1/D18-1259},
  url           = {https://aclanthology.org/D18-1259/},
  eprint        = {1809.09600},
  archiveprefix = {arXiv},
  primaryclass  = {cs.CL},
  eprinttype    = {arxiv},
  eprintclass   = {cs.CL},
  pdf           = {https://aclanthology.org/D18-1259.pdf},
  anthology     = {D18-1259},
  dblp          = {https://dblp.org/rec/conf/emnlp/YangQZBCSM18},
  keywords      = {multi-hop question answering, explainable QA, Wikipedia, supporting facts, HotpotQA},
  abstract      = {Existing question answering (QA) datasets fail to train QA systems to perform complex reasoning and provide explanations for answers. We introduce HotpotQA, a new dataset with 113k Wikipedia-based question-answer pairs with four key features: (1) the questions require finding and reasoning over multiple supporting documents to answer; (2) the questions are diverse and not constrained to any pre-existing knowledge bases or knowledge schemas; (3) we provide sentence-level supporting facts required for reasoning, allowing QA systems to reason with strong supervision and explain the predictions; (4) we offer a new type of factoid comparison questions to test QA systems' ability to extract relevant facts and perform necessary comparison. We show that HotpotQA is challenging for the latest QA systems, and the supporting facts enable models to improve performance and make explainable predictions.},
  note          = {Homepage: \url{https://hotpotqa.github.io/}. Code: \url{https://github.com/hotpotqa/hotpot}. Hugging Face: \url{https://huggingface.co/datasets/hotpotqa/hotpot\_qa}. License: {CC BY-SA 4.0}. Local 300-example export: \texttt{data/hf\_cache/infer\_bench\_export/hotpotqa.jsonl}.}
}

